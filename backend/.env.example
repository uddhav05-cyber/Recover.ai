# ---------------------------------------------------------------------------
# RecoverAI backend — environment template
# Copy this file to `backend/.env` and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database (hosted Postgres: Neon or Supabase) --------------------------
# Async SQLAlchemy needs the asyncpg driver in the URL scheme.
# Neon example:     postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname
# Supabase example: postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres
# If you paste a plain postg:// URL, the app rewrites it to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/recoverai

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# From Razorpay Dashboard → Settings → API Keys (test mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# From Razorpay Dashboard → Settings → Webhooks (the secret you set when creating the webhook).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Google Vertex AI / Gemini (used from Phase 3 onward) ------------------
# Path to a service-account JSON key file, or leave blank to use ADC.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- App ------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
